{
  // 语言项目总仓：合并自四个语言子仓的 .zed/settings.json，
  // 按语言开 LSP 白名单（配合全局 enable_language_server: false）
  // 自动安装项目声明的扩展（官方格式为对象：扩展名 → 允许/禁止安装）

  // 文件扫描排除：子模块构建产物（node_modules/.venv/target/dist 等）会把工作区
  // 撑到 27 万条目，导致 Zed 扫描缓慢、watcher 漏事件（新建文件不出现在侧栏）
  // 260922-这个项目子项目太多了，venv 不能忽略，但是其他的暂时可以
  // 261001-真的是这个问题吗，我设置了但是依旧出现这种问题。哪怕新目录也会出现。
  // （当然 zed 也启动了当前目录，难道一切罪魁祸首都是当前目录？我觉得不合理...）
  // 261001-还真是... zed 为什么不修复，当然可能我这个情况也挺特殊...
  "file_scan_exclusions": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/__pycache__/**",
    "**/target/**",
    "**/.codex/**", // agent 目录屏蔽，可以去资源管理器看
    "**/.claude/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.dsh/**",
    "**/.cursor/**",
    "**/.codex/skills/**", // 直接软链接 .agents/skills 的，无需看
    "**/.claude/skills/**",
    "**/.opencode/skills/**",
    "**/.pi/skills/**",
    "**/.dsh/skills/**",
    "**/.cursor/skills/**",
    "**/.agents/skills/**", // 隐藏了，展开太长了，但是我害怕 zed 里的 agent 都会忽略这个目录
    "**/.idea/**", // .idea 也不需要看，根据我以前使用 idea 的经历，从未改过这个文件...
    ".thirdparty/**", // 第三方库，本来不改放在这个位置的
    ".mkdocs-site/**", // mkdocs
    ".aoci/**", // aoci mcp（可用性待定）
    ".archived/**",
  ],
  "auto_install_extensions": {
    "lua": true,
    "toml": true,
    "sql": true,
    "neocmake": true,
    "html": true,
    "ini": true,
    "xmake": true,
    "java": true,
  },
  "languages": {
    // Java：jdtls 提供智能跳转、补全与重构（指定 Java 21 环境）
    "Java": {
      "enable_language_server": true,
      "language_servers": ["jdtls"],
      "formatter": "language_server",
    },
    // Python：basedpyright 跳转 + ruff 格式化
    "Python": {
      "enable_language_server": true,
      "language_servers": ["basedpyright", "ruff"],
      "formatter": "language_server",
    },
    // Go：gopls 提供跳转（go_projects 及 python_projects 内 Go 启动器均适用）
    "Go": {
      "enable_language_server": true,
      "language_servers": ["gopls"],
    },
    // Rust：rust-analyzer 跳转
    "Rust": {
      "enable_language_server": false,
      "language_servers": ["rust-analyzer"],
    },
    // TS/TSX/JS：vtsls 跳转
    "TypeScript": {
      "enable_language_server": false,
      "language_servers": ["vtsls"],
    },
    "TSX": { "enable_language_server": false, "language_servers": ["vtsls"] },
    "JavaScript": {
      "enable_language_server": false,
      "language_servers": ["vtsls"],
    },
    // HTML/CSS：Zed 内置服务器，仅零星文件，不开
    "HTML": { "enable_language_server": false },
    "CSS": { "enable_language_server": false },
    // C/C++：clangd 跳转（native_projects；优先用 PATH 里的 LLVM clangd，无则 Zed 自动下载）
    "C": { "enable_language_server": false, "language_servers": ["clangd"] },
    "C++": { "enable_language_server": false, "language_servers": ["clangd"] },
    // Lua：lua-language-server 跳转（native_projects 的嵌入脚本）
    "Lua": {
      "enable_language_server": false,
      "language_servers": ["lua-language-server"],
    },
  },
  "lsp": {
    // jdtls: Eclipse JDT Language Server (自动继承环境变量 JAVA_HOME / PATH)
    "jdtls": {
      "settings": {
        "lombok_support": true,
        "min_memory": "128m",
        "max_memory": "512m",
      },
      "initialization_options": {
        "settings": {
          "java": {
            "errors": {
              "incompleteClasspath": {
                "severity": "warning",
              },
            },
          },
        },
      },
    },
    // basedpyright：彻底关闭类型推断告警，仅分析打开文件以压低内存
    "basedpyright": {
      "settings": {
        "basedpyright": {
          "analysis": {
            "typeCheckingMode": "off",
            "diagnosticMode": "openFilesOnly",
            "autoSearchPaths": false,
          },
        },
      },
    },
    // ruff：彻底关掉代码检查与提示，只留格式化
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": { "enable": false },
          "hover": false,
        },
      },
    },
    // rust-analyzer：压内存——关保存时 cargo check 子进程、
    // 关 proc-macro 展开（本项目纯标准库用不到）
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": false,
        "procMacro": { "enable": false },
        "cargo": { "allTargets": false },
      },
    },
    "vtsls": {
      "settings": {
        "typescript": {
          "tsserver": { "maxTsServerMemory": 2048 },
        },
        "javascript": {
          "tsserver": { "maxTsServerMemory": 2048 },
          "disableAutomaticTypeAcquisition": true,
        },
      },
    },
    // clangd：关后台全量索引省内存；编译数据库由各项目自己的 .clangd
    // 指定（如 trilang/.clangd），不在此全局写死路径
    "clangd": {
      "binary": {
        "arguments": ["--background-index=false"],
      },
    },
    // lua-language-server：默认按 Lua 5.4 提供标准库签名，本仓嵌入的是
    // 5.1.5（LuaJIT 也基于 5.1），显式指定运行时版本，跳转/补全才对得上
    "lua-language-server": {
      "settings": {
        "Lua": {
          "runtime": { "version": "Lua 5.1" },
        },
      },
    },
  },
}
